global.cutscene = false; //Identifica se está ou não em uma cutscene
global.pause	= false; //Identifica se o jogo está pausado ou não
global.sfx		= 1; //Valor global do volume dos efeitos sonoros				-- Não reiniciável
global.snd		= 1; //valor global do volume das músicas						-- Não reiniciável
global.lenguage	= "English"; //Global que cuida da tradução						-- Não reiniciável
global.hitstop  = false; //Global que cuida do feeling hitstop dos golpes
